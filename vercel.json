{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(cesium|models)/(.*)",
      "headers": { "cache-control": "public, max-age=86400" },
      "continue": true
    },
    { "src": "/", "dest": "/landing/index.html" },
    { "src": "/app/?", "dest": "/index.html" },
    { "handle": "filesystem" }
  ]
}
